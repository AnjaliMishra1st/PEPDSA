subsequence of string using recursion
#include<iostream>
using namespace std;
void printSubsequence(string s, int index, string output){
    // base case
    if(index==s.length()){
        cout<<output<<endl;
        return;

    }
    // process
    // exclude the current character and increase the index
    printSubsequence(s, index+1, output);
    // include the current character and then increase index
    printSubsequence(s, index+1, output+s[index]);
}

int main(){
    string s="abc";
    cout<<"all subsequence are"<<endl;
    printSubsequence(s,"",0);
    return 0;
}

