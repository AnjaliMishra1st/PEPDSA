
// Arranging coin 
class solution{
    public:
    int arrageCoins(int n){
        int left=0;
        int right=n;
        while(left<=right){
            long long mid=left+(right-left)/2;
            long long curr=mid*(mid+1)/2;
            if(curr==n){
                return mid;
            }else if(curr<n){
                left=mid+1;
            }else{
                right=mid-1;
            }
        }
        return right;
    }
}

