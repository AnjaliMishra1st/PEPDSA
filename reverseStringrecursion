# reverse string using recursion

#include <iostream>
using namespace std;
void reverseString(string s, int size){
    if(size<0){
        return;
        
    }
    // process
    cout<<s[size];
    reverseString(s, size-1);
}
int main(){
    string s="hello";
    reverseString(s, s.length() - 1);
    return 0;
}
