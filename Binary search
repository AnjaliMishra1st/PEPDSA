#include <iostream>
using namespace std;
int binarySearch(int arr[],int size, int target){
    int start=0;
    int end=size-1;
    while(start<=end){
        int mid=start+end/2;
        if(arr[mid]==target){
            return mid;
        }else if(arr[mid]<target){
            start=mid+1;
        }else{
            end=mid-1;
        }
    }
    return -1;
}
int main(){
    int arr[]={2,5,8,12,16,23,38,56,72,91};
    int size = 10;
    int target;
    cout<<"enter the element to search:"<<endl;
    cin>>target;
    int result=binarySearch(arr, size, target);
    
    
}
